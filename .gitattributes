# Large source images tracked with Git LFS.
#
# Scope is deliberately narrow: only the full-resolution originals that live
# directly in public/assets. These are build-time source material for
# scripts/optimize-images.mjs and are never served to browsers.
#
# Deliberately NOT tracked:
#   - public/assets/opt/**  the derivatives the site actually serves
#   - *.pdf                 George_Ma_Resume.pdf is served at /resume
# Vercel does not fetch LFS objects when it builds, so anything the deployed
# site serves must stay as a normal Git blob or it becomes a pointer file.
public/assets/*.png  filter=lfs diff=lfs merge=lfs -text
public/assets/*.jpg  filter=lfs diff=lfs merge=lfs -text
public/assets/*.JPG  filter=lfs diff=lfs merge=lfs -text
public/assets/*.jpeg filter=lfs diff=lfs merge=lfs -text
public/assets/*.JPEG filter=lfs diff=lfs merge=lfs -text
